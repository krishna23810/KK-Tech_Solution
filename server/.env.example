# Database Connection URI
DB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>"

# Server Port
PORT=4000

# Frontend Client URL for CORS
FRONTEND_URL="http://localhost:3000"

# Email SMTP Credentials (Nodemailer)
EMAIL_HOST="smtp.gmail.com"
EMAIL_ID="your_email@gmail.com"
EMAIL_PASSWORD="your_app_password"
ADMIN_EMAIL="admin_email@gmail.com"

# JWT Secret
JWT_SECRET="your_jwt_secret"

# Cloudinary Configuration
Cloudname="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
Folde_Name="courses"
CLOUDINARY_VIDEO_FOLDER="videos"
CLOUDINARY_COURSE_THUMBNAIL_FOLDER="thumbnails"
profile_Folde_Name="profile"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
